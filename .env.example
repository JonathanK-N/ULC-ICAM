# =============================================================================
#                  CONFIGURATION ULC-ICAM TURNIN SYSTEM
#                  Copiez vers .env et remplissez vos valeurs
# =============================================================================

# --- Flask ---
FLASK_SECRET_KEY=changez_cette_valeur_en_production_32_chars_minimum
FLASK_ENV=development    # development | production

# --- OpenAI (optionnel - pour correction IA avancée) ---
OPENAI_API_KEY=sk-...

# --- Google Custom Search (optionnel - détection plagiat web) ---
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# --- Email (pour notifications) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application_gmail
MAIL_DEFAULT_SENDER=noreply@ulc-icam.cd
NOTIFICATIONS_ENABLED=false

# --- Upload ---
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=16777216   # 16 MB

# --- Celery & Redis (optionnel - tâches asynchrones) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Judge0 (optionnel - exécution de code sécurisée) ---
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=votre_clé_rapidapi

# Aucun compilateur local : exécution étudiant uniquement via sandbox distante.

# Mode relationnel explicite, seulement après import isolé vérifié.
COGNITO_STORAGE=json
# DATABASE_URL=postgresql+psycopg://user:password@localhost/cognito_test
# DATA_FILE=/app/data/ulc_icam_data.json

# Modèle explicitement choisi ; sans configuration, validation manuelle.
# OPENAI_MODEL=

# Web Push volontaire depuis les préférences utilisateur.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:administrateur@example.com

# --- Stockage Cloud (optionnel) ---
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=ulc-icam-uploads
# AZURE_STORAGE_CONNECTION_STRING=...

# Bootstrap only for an empty isolated installation; no default password.
# BOOTSTRAP_ADMIN_PASSWORD=
