# =============================================================================
#                    CONFIGURATION ULC-ICAM TURNIN SYSTEM
# =============================================================================
#
# Fichier de configuration des variables d'environnement
# Copiez ce fichier vers .env et remplissez vos vraies valeurs
#
# Développeur: Jonathan Kakesa
# Date: Décembre 2024
# Version: 2.0 avec notifications email
#
# =============================================================================

# Configuration des clés API pour les services d'IA et de détection de plagiat

# OpenAI API (pour correction automatique avancée)
OPENAI_API_KEY=your_openai_api_key_here

# Google Custom Search API (pour détection de plagiat web)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=development

# Configuration Email (pour notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER=noreply@ulc-icam.cd
NOTIFICATIONS_ENABLED=true

# Autres configurations
MAX_FILE_SIZE=16777216
UPLOAD_FOLDER=uploads