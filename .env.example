# =============================================================================
#                  CONFIGURATION ULC-ICAM TURNIN SYSTEM
#                  Copiez vers .env et remplissez vos valeurs
# =============================================================================

# --- Flask ---
FLASK_SECRET_KEY=changez_cette_valeur_en_production_32_chars_minimum
FLASK_ENV=development    # development | production

# --- OpenAI (optionnel - pour correction IA avancée) ---
OPENAI_API_KEY=sk-...

# --- Google Custom Search (optionnel - détection plagiat web) ---
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# --- Email (pour notifications) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application_gmail
MAIL_DEFAULT_SENDER=noreply@ulc-icam.cd
NOTIFICATIONS_ENABLED=true

# --- Upload ---
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=16777216   # 16 MB

# --- Celery & Redis (optionnel - tâches asynchrones) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Judge0 (optionnel - exécution de code sécurisée) ---
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=votre_clé_rapidapi

# --- Compilateurs C/C++ (Windows avec MSYS2) ---
# Décommentez si gcc n'est pas dans votre PATH système
# C_COMPILER=C:\msys64\mingw64\bin\gcc.exe
# CPP_COMPILER=C:\msys64\mingw64\bin\g++.exe
# MSYS2_BIN=C:\msys64\mingw64\bin

# --- Stockage Cloud (optionnel) ---
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=ulc-icam-uploads
# AZURE_STORAGE_CONNECTION_STRING=...
